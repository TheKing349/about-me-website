// use prisma-8

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  desc          String
  image         String
  publishLink   String?
  githubLink    String?
  creationDate  TimestamptzString
  insights      String?
  tools         String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
