// use prisma-8

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  desc          String
  images        Image[]
  publishLink   String?
  githubLink    String?
  creationDate  TimestamptzString
  insights      String?
  tools         String?
}

type Image {
  width       Int
  height      Int
  url         String
  alt         String
}