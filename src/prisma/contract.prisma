// use prisma-8

model Project {
  id            Int     @id @default(autoincrement())
  title         String
  description   String
  images        Image[]
  links         LinkType[]
  creationDate  Date
  insights      String?

  statusId      Int
  status        Status  @relation(fields: [statusId], references: [id])

  variantId     Int
  variant       Variant @relation(fields: [variantId], references: [id])

  projectTools  ProjectTool[]
}

model Tool {
  id            Int     @id @default(autoincrement())
  name          String
  color         String

  projectTools  ProjectTool[]
}

model ProjectTool {
  projectId     Int
  toolId        Int

  project       Project @relation(fields: [projectId], references: [id])
  tool          Tool    @relation(fields: [toolId], references: [id])

  @@id([projectId, toolId])
}

model Status {
  id            Int     @id @default(autoincrement())
  name          String
  color         String
}

model Variant {
  id            Int     @id @default(autoincrement())
  name          String
  color         String
}

type Image {
  url           String
  alt           String
}

type LinkType {
  name          String?
  url           String
}
