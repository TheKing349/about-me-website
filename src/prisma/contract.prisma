// use prisma-8

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  desc          String
  images        Image[]
  links         LinkType[]
  creationDate  Date
  insights      String?

  projectTools  ProjectTool[]
}

model Tool {
  id            Int     @id @default(autoincrement())
  name          String
  color         String

  projectTools  ProjectTool[]
}

model ProjectTool {
  projectId     Int
  toolId        Int

  project       Project @relation(fields: [projectId], references: [id])
  tool          Tool    @relation(fields: [toolId], references: [id])

  @@id([projectId, toolId])
}

type Image {
  width         Int
  height        Int
  url           String
  alt           String
}

type LinkType {
  name          String?
  url           String
}